# Set this on Airflow scheduler and worker hosts to the mounted CSV directory.
RETAILFLOW_DATA_DIR=/opt/airflow/data/retailflow

# Must match a Snowflake connection configured in Airflow.
SNOWFLAKE_CONN_ID=snowflake_default

# Path to this repository's dbt project on the Airflow worker.
RETAILFLOW_DBT_DIR=/opt/airflow/retailflow-data-platform/retailflow_dbt
